Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|lib|database|scripts|docs)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(md|sql|json|lock)$ - [F,L]
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>
